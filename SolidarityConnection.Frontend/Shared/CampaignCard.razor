</style>

@code {
    [Parameter, EditorRequired]
    public CampaignSummaryModel Campaign { get; set; } = default!;

    private static readonly CultureInfo BrazilianCulture = CultureInfo.GetCultureInfo("pt-BR");
    private static readonly decimal[] SuggestedAmounts = [10m, 50m, 100m];

    private bool _isDonationModalOpen;
    private bool _isSubmittingDonation;
    private bool _showAmountValidation;
    private string? _donationErrorMessage;
    private decimal? _donationAmount;

    private decimal ProgressPercentage
        => Campaign.TargetAmount <= 0
            ? 0
            : Math.Min(100, Math.Round(Campaign.AmountRaised / Campaign.TargetAmount * 100, 0));

    private string ProgressText => $"{ProgressPercentage:F0}% da meta";

    private string StatusLabel => NormalizedStatus switch
    {
        "PAUSED" => "Campanha pausada",
        "CLOSED" => "Campanha encerrada",
        _ => "Campanha ativa"
    };

    private string StatusBadgeClass => NormalizedStatus switch
    {
        "PAUSED" => "campaign-badge-paused",
        "CLOSED" => "campaign-badge-closed",
        _ => "campaign-badge-active"
    };

    private string StatusFillClass => NormalizedStatus switch
    {
        "PAUSED" => "campaign-progress-fill-paused",
        "CLOSED" => "campaign-progress-fill-closed",
        _ => "campaign-progress-fill-active"
    };

    private string CampaignDescription
        => string.IsNullOrWhiteSpace(Campaign.Description)
            ? "Apoie esta mobilização e acompanhe a meta sendo alcançada junto com a comunidade."
            : Campaign.Description;

    private string NormalizedStatus => (Campaign.Status ?? string.Empty).Trim().ToUpperInvariant();

    private bool CanDonate => string.Equals(NormalizedStatus, "ACTIVE", StringComparison.Ordinal);

    private bool IsDonationAmountValid => _donationAmount is > 0;

    private string MaskedUserName => MaskUserName(Session.CurrentUser.Name);

    private async Task OpenDonationModalAsync(decimal? suggestedAmount)
    {
        await Session.EnsureInitializedAsync();

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!CanDonate)
        {
            return;
        }

        _donationErrorMessage = null;
        _showAmountValidation = false;
        _donationAmount = suggestedAmount;
        _isDonationModalOpen = true;
    }

    private void CloseDonationModal(bool force = false)
    {
        if (_isSubmittingDonation && !force)
        {
            return;
        }

        _isDonationModalOpen = false;
        _donationAmount = null;
        _donationErrorMessage = null;
        _showAmountValidation = false;
    }

    private async Task SubmitDonationAsync()
    {
        _showAmountValidation = !IsDonationAmountValid;
        _donationErrorMessage = null;

        if (!IsDonationAmountValid || _donationAmount is null)
        {
            return;
        }

        _isSubmittingDonation = true;

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/Donation",
                new CreateDonationRequest
                {
                    CampaignId = Campaign.Id,
                    Amount = _donationAmount.Value
                });

            if (response.IsSuccessStatusCode)
            {
                var success = await response.Content.ReadFromJsonAsync<DonationResponse>();
                Snackbar.Add(success?.Message ?? "Sua doação foi recebida e será processada em breve.", Severity.Success);
                CloseDonationModal(force: true);
                return;
            }

            var failure = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _donationErrorMessage = failure?.Message ?? "Não foi possível registrar a doação agora.";
        }
        catch
        {
            _donationErrorMessage = "Não foi possível se conectar ao servidor no momento.";
        }
        finally
        {
            _isSubmittingDonation = false;
        }
    }

    private static string MaskUserName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "A*** S*****";
        }

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', parts.Select(MaskPart));
    }

    private static string MaskPart(string part)
    {
        if (part.Length <= 1)
        {
            return "*";
        }

        return part[0] + new string('*', Math.Max(2, part.Length - 1));
    }

    private static string FormatCurrency(decimal value)
        => value.ToString("C", BrazilianCulture);

    private sealed class CreateDonationRequest
    {
        public Guid CampaignId { get; set; }

        public decimal Amount { get; set; }
    }

    private sealed class DonationResponse
    {
        public Guid DonationId { get; set; }

        public string Message { get; set; } = string.Empty;
    }

    private sealed class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}