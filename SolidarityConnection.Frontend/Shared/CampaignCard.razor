@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AppSessionService Session
@inject ISnackbar Snackbar

<article class="campaign-card">
    <div class="campaign-card-top">
        <span class="campaign-badge @StatusBadgeClass">@StatusLabel</span>
        <span class="campaign-progress-label">@ProgressText</span>
    </div>

    <div class="campaign-copy">
        <h2 class="campaign-title">@Campaign.Title</h2>
        <p class="campaign-description">
            @CampaignDescription
        </p>
    </div>

    <div class="campaign-progress">
        <div class="campaign-progress-bar">
            <span class="campaign-progress-fill @StatusFillClass" style="@($"width: {ProgressPercentage:F0}%;")"></span>
        </div>
    </div>

    <dl class="campaign-values">
        <div>
            <dt>Arrecadado</dt>
            <dd>@FormatCurrency(Campaign.AmountRaised)</dd>
        </div>
        <div>
            <dt>Meta</dt>
            <dd>@FormatCurrency(Campaign.TargetAmount)</dd>
        </div>
    </dl>

    <div class="campaign-actions">
        @foreach (var suggestedAmount in SuggestedAmounts)
        {
            <button type="button"
                    class="donation-chip"
                    disabled="@(!CanDonate)"
                    @onclick="() => OpenDonationModalAsync(suggestedAmount)">
                <span class="donation-chip-prefix">R$</span>
                <span class="donation-chip-value">@suggestedAmount.ToString("N0", BrazilianCulture)</span>
                <span class="donation-chip-cents">,00</span>
            </button>
        }

        <button type="button"
                class="donation-primary"
                disabled="@(!CanDonate)"
                @onclick="() => OpenDonationModalAsync(null)">
            Doar
        </button>
    </div>
</article>

@if (_isDonationModalOpen)
{
    <div class="donation-modal-backdrop" @onclick="() => CloseDonationModal()"></div>

    <section class="donation-modal-shell" aria-modal="true" role="dialog" aria-label="Pagamento da doação">
        <div class="donation-modal-card" @onclick:stopPropagation="true">
            <div class="donation-modal-header">
                <div>
                    <h3 class="donation-modal-title">Finalizar doação</h3>
                    <p class="donation-modal-subtitle">Pagamento para a campanha @Campaign.Title.</p>
                </div>

                <button type="button" class="donation-modal-close" @onclick="() => CloseDonationModal()" aria-label="Fechar modal">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>

            <div class="payment-preview">
                <div class="payment-preview-card">
                    <span class="payment-preview-chip"></span>
                    <strong class="payment-preview-number">**** **** **** 4829</strong>
                    <div class="payment-preview-meta">
                        <span>@MaskedUserName</span>
                        <span>12/29</span>
                    </div>
                </div>

                <div class="payment-preview-summary">
                    <div class="payment-preview-row">
                        <span>Titular</span>
                        <strong>@MaskedUserName</strong>
                    </div>
                    <div class="payment-preview-row">
                        <span>Cartão</span>
                        <strong>Visa final 4829</strong>
                    </div>
                    <div class="payment-preview-row">
                        <span>Campanha</span>
                        <strong>@StatusLabel</strong>
                    </div>
                </div>
            </div>

            <MudNumericField T="decimal?"
                             Label="Valor da doação"
                             Variant="Variant.Outlined"
                             FullWidth="true"
                             Immediate="true"
                             HideSpinButtons="true"
                             Min="0.01m"
                             Step="10"
                             Culture="@BrazilianCulture"
                             Adornment="Adornment.Start"
                             AdornmentText="R$"
                             @bind-Value="_donationAmount" />

            @if (_showAmountValidation)
            {
                <p class="donation-validation-message">Informe um valor maior que zero para continuar.</p>
            }

            @if (!string.IsNullOrWhiteSpace(_donationErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                    @_donationErrorMessage
                </MudAlert>
            }

            <div class="donation-modal-actions">
                <button type="button" class="donation-secondary" @onclick="() => CloseDonationModal()" disabled="@_isSubmittingDonation">
                    Cancelar
                </button>

                <button type="button"
                        class="donation-confirm"
                        @onclick="SubmitDonationAsync"
                        disabled="@(!IsDonationAmountValid || _isSubmittingDonation)">
                    @if (_isSubmittingDonation)
                    {
                        <span>Processando...</span>
                    }
                    else
                    {
                        <span>Doar agora</span>
                    }
                </button>
            </div>
        </div>
    </section>
}

<style>
