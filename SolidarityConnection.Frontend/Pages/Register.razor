@page "/cadastro"

<PageTitle>Conexao Solidaria | Cadastro</PageTitle>

<div class="placeholder-shell">
    <MudPaper Class="placeholder-card" Elevation="0">
        <MudText Typo="Typo.overline" Class="placeholder-kicker">Em construcao</MudText>
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="placeholder-title">Cadastro em breve</MudText>
        <MudText Typo="Typo.body1" Class="placeholder-copy">
            O atalho ja esta pronto no menu. Quando voce mandar a proxima etapa, encaixamos a tela de cadastro aqui.
        </MudText>
        <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled">
            Ir para login
        </MudButton>
    </MudPaper>
</div>