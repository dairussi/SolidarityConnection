    .users-stat-pill {
        display: grid;
        gap: 0.2rem;
        min-width: 12rem;
        padding: 0.95rem 1rem;
        border-radius: 1rem;
        background: #faf5ff;
        box-shadow: inset 0 0 0 1px #ede9fe;
    }

    .users-stat-pill span,
    .users-card-metric span {
        font-size: 0.82rem;
        font-weight: 700;
    }

    .users-stat-pill strong,
    .users-card-metric strong {
        color: #111827;
        font-size: 1.1rem;
    }

    .users-list-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .users-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.4rem;
    }

    .users-card-top,
    .users-card-toggle-row,
    .users-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .users-card-copy {
        gap: 0.3rem;
