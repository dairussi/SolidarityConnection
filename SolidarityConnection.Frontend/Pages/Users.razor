@page "/usuarios"
@using System.Net
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AppSessionService Session
@inject NavigationManager Navigation

<PageTitle>Conexão Solidária | Usuários</PageTitle>

<div class="users-shell">
    <div class="users-stage">
        @if (_isLoading)
        {
            <section class="users-loading-state" aria-label="Carregando usuários">
                <div class="users-loading-hero"></div>

                <div class="users-loading-grid">
                    @for (var index = 0; index < 4; index++)
                    {
                        <div class="users-loading-card"></div>
                    }
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                @_errorMessage
            </MudAlert>
        }
        else
        {
            <section class="users-hero">
                <MudPaper Class="users-hero-card" Elevation="0">
                    <div class="users-hero-copy">
                        <MudText Typo="Typo.h4" HtmlTag="h1" Class="users-hero-title">
                            Usuários do sistema
                        </MudText>

                        <MudText Typo="Typo.body1" Class="users-hero-description">
                            Gerencie quem recebe acesso administrativo. Para seguir LGPD, a lista mostra o nome e o e-mail parcialmente mascarado.
                        </MudText>
                    </div>

                    <div class="users-hero-stats">
                        <div class="users-stat-pill">
                            <span>Total de usuários</span>
                            <strong>@_pagedResult.TotalCount</strong>
                        </div>

                        <div class="users-stat-pill">
                            <span>Admins nesta página</span>
                            <strong>@AdminsOnCurrentPage</strong>
                        </div>
                    </div>
                </MudPaper>
            </section>

            @if (_users.Count == 0)
            {
                <MudPaper Class="users-empty-state" Elevation="0">
                    <div class="users-empty-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" />
                    </div>

                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="users-empty-title">
                        Nenhum usuário encontrado.
                    </MudText>

                    <MudText Typo="Typo.body2" Class="users-empty-description">
                        Tente novamente em instantes para recarregar a lista paginada de usuários.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <section class="users-list-section">
                    <div class="users-list-header">
                        <div class="users-list-copy">
                            <MudText Typo="Typo.h5" HtmlTag="h2" Class="users-list-title">
                                Perfis cadastrados
                            </MudText>

                            <MudText Typo="Typo.body2" Class="users-list-description">
                                Página @_pagedResult.Page de @_pagedResult.TotalPages. Ative o controle para conceder acesso administrativo ao usuário.
                            </MudText>
                        </div>
                    </div>

                    <div class="users-grid">
                        @foreach (var user in _users)
                        {
                            <MudPaper Class="users-card" Elevation="0">
                                <div class="users-card-top">
                                    <div class="users-card-copy">
                                        <MudText Typo="Typo.h6" HtmlTag="h3" Class="users-card-title">
                                            @user.Name
                                        </MudText>

                                        <MudText Typo="Typo.body2" Class="users-card-email">
                                            @MaskEmail(user.Email)
                                        </MudText>
                                    </div>

                                    <MudChip T="string" Color="@(user.IsAdmin ? Color.Secondary : Color.Default)"
                                             Variant="Variant.Outlined"
                                             Size="Size.Small">
                                        @(user.IsAdmin ? "Admin" : "Doador")
                                    </MudChip>
                                </div>

                                <div class="users-card-metrics">
                                    <div class="users-card-metric">
                                        <span>Status da conta</span>
                                        <strong>@(user.IsActive ? "Ativa" : "Inativa")</strong>
                                    </div>

                                    <div class="users-card-metric">
                                        <span>Perfil atual</span>
                                        <strong>@GetRoleLabel(user.Role)</strong>
                                    </div>
                                </div>

                                <div class="users-card-toggle-row">
                                    <div class="users-toggle-copy">
                                        <MudText Typo="Typo.body1" Class="users-toggle-title">
                                            Acesso administrativo
                                        </MudText>

                                        <MudText Typo="Typo.body2" Class="users-toggle-description">
                                            Quando ativo, o usuário recebe permissões de gestão para campanhas e administração.
                                        </MudText>
                                    </div>

                                    <MudSwitch T="bool"
                                               Color="Color.Secondary"
                                               Value="@user.IsAdmin"
                                               ValueChanged="@(value => ToggleAdminRoleAsync(user, value))"
                                               Disabled="@IsToggleBusy(user.PublicId)" />
                                </div>
                            </MudPaper>
                        }
                    </div>

                    <div class="users-pagination">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(!_pagedResult.HasPrevious || _isLoadingPage)"
                                   OnClick="LoadPreviousPageAsync">
                            Página anterior
                        </MudButton>

                        <span class="users-pagination-label">
                            Mostrando @(_users.Count) de @_pagedResult.TotalCount usuários
                        </span>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(!_pagedResult.HasNext || _isLoadingPage)"
                                   OnClick="LoadNextPageAsync">
                            Próxima página
                        </MudButton>
                    </div>
                </section>
            }
        }
    </div>
</div>

<style>
