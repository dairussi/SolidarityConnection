        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .users-loading-card {
        min-height: 15rem;
    }

    .users-hero-card,
    .users-card,
    .users-empty-state {
        border-radius: 1.5rem;
        border: 1px solid #ede9fe;
        box-shadow: none;
        background: #fff;
    }

    .users-hero-card {
        display: grid;
        grid-template-columns: minmax(0, 2fr) auto;
        gap: 1rem;
        align-items: center;
        padding: 1.6rem;
    }

    .users-hero-copy,
    .users-list-copy,
    .users-card-copy,
    .users-toggle-copy {
