</style>

@code {
    private const int PageSize = 8;

    private readonly List<AdminUserListItem> _users = [];
    private readonly HashSet<Guid> _pendingRoleChanges = [];
    private PagedResult<AdminUserListItem> _pagedResult = new();
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isLoadingPage;

    private int AdminsOnCurrentPage => _users.Count(user => user.IsAdmin);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitializedAsync();

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (!Session.IsAdmin)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync(int page = 1)
    {
        _isLoading = page == 1 && _users.Count == 0;
        _isLoadingPage = !_isLoading;
        _errorMessage = null;

        try
        {
            var response = await Http.GetAsync($"api/User?page={page}&pageSize={PageSize}");

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                await Session.SignOutAsync();
                Navigation.NavigateTo("/login", replace: true);
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PagedResult<AdminUserListItem>>();

                _users.Clear();
                _pagedResult = result ?? new PagedResult<AdminUserListItem>();

                if (result?.Items is not null)
                {
                    _users.AddRange(result.Items);
                }

                return;
            }

            var failure = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            _errorMessage = failure?.Message ?? "Não foi possível carregar a lista de usuários agora.";
        }
        catch
        {
            _errorMessage = "Não foi possível se conectar ao servidor no momento.";
        }
        finally
        {
            _isLoading = false;
            _isLoadingPage = false;
        }
    }

    private Task LoadPreviousPageAsync()
    {
        return _pagedResult.HasPrevious ? LoadUsersAsync(_pagedResult.Page - 1) : Task.CompletedTask;
    }

    private Task LoadNextPageAsync()
    {
        return _pagedResult.HasNext ? LoadUsersAsync(_pagedResult.Page + 1) : Task.CompletedTask;
    }

    private async Task ToggleAdminRoleAsync(AdminUserListItem user, bool shouldBeAdmin)
    {
        if (user.IsAdmin == shouldBeAdmin || !_pendingRoleChanges.Add(user.PublicId))
        {
            return;
        }

        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Patch, "api/User/Role")
            {
                Content = JsonContent.Create(new ToggleRoleRequest { PublicId = user.PublicId })
            };

            var response = await Http.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                await Session.SignOutAsync();
                Navigation.NavigateTo("/login", replace: true);
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var updatedUser = await response.Content.ReadFromJsonAsync<AdminUserListItem>();

                if (updatedUser is not null)
                {
                    user.Name = updatedUser.Name;
                    user.Email = updatedUser.Email;
                    user.Cpf = updatedUser.Cpf;
                    user.IsActive = updatedUser.IsActive;
                    user.Role = updatedUser.Role;
                }
                else
                {
                    user.Role = shouldBeAdmin ? "GestorONG" : "Doador";
                }

                Snackbar.Add(
                    shouldBeAdmin
                        ? $"Acesso administrativo concedido para {user.Name}."
                        : $"Acesso administrativo removido de {user.Name}.",
                    Severity.Success);

                return;
            }

            var failure = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            Snackbar.Add(failure?.Message ?? "Não foi possível atualizar a permissão deste usuário.", Severity.Error);
        }
        catch
        {
            Snackbar.Add("Não foi possível se conectar ao servidor no momento.", Severity.Error);
        }
        finally
        {
            _pendingRoleChanges.Remove(user.PublicId);
        }
    }

    private bool IsToggleBusy(Guid publicId)
    {
        return _pendingRoleChanges.Contains(publicId);
    }

    private static string GetRoleLabel(string? role)
    {
        return string.Equals(role, "GestorONG", StringComparison.OrdinalIgnoreCase)
            ? "Gestor ONG"
            : "Doador";
    }

    private static string MaskEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "e-mail indisponível";
        }

        var parts = email.Trim().Split('@', 2, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length != 2)
        {
            return email.Trim();
        }

        var domainParts = parts[1].Split('.', 2, StringSplitOptions.RemoveEmptyEntries);
        var maskedLocal = MaskEmailSegment(parts[0], 2, 1);
        var maskedDomain = domainParts.Length == 0
            ? "***"
            : MaskEmailSegment(domainParts[0], 1, 1);

        return domainParts.Length > 1
            ? $"{maskedLocal}@{maskedDomain}.{domainParts[1]}"
            : $"{maskedLocal}@{maskedDomain}";
    }

    private static string MaskEmailSegment(string segment, int visiblePrefix, int visibleSuffix)
    {
        if (string.IsNullOrWhiteSpace(segment))
        {
            return "***";
        }

        if (segment.Length <= visiblePrefix + visibleSuffix)
        {
            return segment[0] + new string('*', Math.Max(1, segment.Length - 1));
        }

        var prefix = segment[..visiblePrefix];
        var suffix = segment[^visibleSuffix..];
        return prefix + new string('*', Math.Max(3, segment.Length - visiblePrefix - visibleSuffix)) + suffix;
    }

    private sealed class AdminUserListItem
    {
        public Guid PublicId { get; set; }

        public string Name { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string Cpf { get; set; } = string.Empty;

        public bool IsActive { get; set; }

        public string Role { get; set; } = string.Empty;

        public bool IsAdmin => string.Equals(Role, "GestorONG", StringComparison.OrdinalIgnoreCase);
    }

    private sealed class ToggleRoleRequest
    {
        public Guid PublicId { get; set; }
    }

    private sealed class ApiErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}