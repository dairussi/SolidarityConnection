        flex-direction: column;
    }

    .users-hero-copy,
    .users-list-copy,
    .users-toggle-copy {
        gap: 0.5rem;
    }

    .users-hero-title,
    .users-list-title,
    .users-card-title,
    .users-empty-title {
        color: #111827;
        font-weight: 700;
    }

    .users-hero-description,
    .users-list-description,
    .users-card-email,
    .users-toggle-description,
    .users-empty-description,
