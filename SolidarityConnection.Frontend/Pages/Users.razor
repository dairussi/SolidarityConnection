        flex: 1 1 auto;
        min-height: 100%;
        width: 100%;
        display: flex;
        padding: 0;
        margin: 0;
        background:
            radial-gradient(circle at top left, rgba(221, 214, 254, 0.42), transparent 24%),
            linear-gradient(180deg, #fcfbff 0%, #ffffff 36%, #faf5ff 100%);
    }

    .users-stage {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 2.5rem 3rem 3rem;
        box-sizing: border-box;
    }

    .users-loading-state,
    .users-loading-grid,
    .users-grid {
        display: grid;
        gap: 1rem;
    }

    .users-loading-hero,
    .users-loading-card {
        border-radius: 1.5rem;
