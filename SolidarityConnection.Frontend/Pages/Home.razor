@page "/"
@implements IDisposable
@inject HttpClient Http
@inject AppSessionService Session

<PageTitle>Conexão Solidária | Campanhas</PageTitle>

<div class="home-shell">
    <div class="home-stage">
        <section class="home-panel">
            <div class="home-copy">
                <MudText Typo="Typo.h4" HtmlTag="h1" Class="home-heading">Campanhas em destaque</MudText>
                <MudText Typo="Typo.body1" Class="home-description">
                    @HomeDescription
                </MudText>
            </div>

            @if (_isLoading)
            {
                <div class="campaign-grid">
                    @for (var index = 0; index < 3; index++)
                    {
                        <div class="campaign-skeleton"></div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @_errorMessage
                </MudAlert>
            }
            else if (_campaigns.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @EmptyStateMessage
                </MudAlert>
            }
            else
            {
                <div class="campaign-grid">
                    @foreach (var campaign in _campaigns)
                    {
                        <CampaignCard Campaign="campaign" />
                    }
                </div>
            }
        </section>
    </div>
</div>

<style>
    .home-shell {
        flex: 1 1 auto;
        min-height: 100%;
        width: 100%;
        display: flex;
        padding: 0;
        margin: 0;
        background: #fff;
    }

    .home-stage {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        width: 100%;
        min-height: 100%;
        background: #fff;
    }

    .home-panel {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 2.5rem 3rem 3rem;
        box-sizing: border-box;
    }

    .home-copy {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .home-heading {
        font-weight: 700;
        color: #111827;
    }

    .home-description {
        color: #6b7280;
        max-width: 560px;
    }

    .campaign-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .campaign-skeleton {
        min-height: 240px;
        border-radius: 1.5rem;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.48) 25%, rgba(237, 233, 254, 0.92) 50%, rgba(255, 255, 255, 0.48) 75%);
        background-size: 400% 100%;
        animation: shimmer 1.5s infinite linear;
        border: 1px solid #e9d5ff;
    }

    @@keyframes shimmer {
        0% {
            background-position: 100% 0;
        }

        100% {
            background-position: -100% 0;
        }
    }

    @@media (max-width: 1100px) {
        .campaign-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .home-stage {
            min-height: 100%;
        }

        .home-panel {
            padding: 2rem 1.25rem 2.5rem;
        }

        .campaign-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private readonly List<CampaignSummaryModel> _campaigns = [];
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool? _lastAuthenticatedState;
    private bool _hasCompletedInitialLoad;

    private string HomeDescription => Session.IsAuthenticated
        ? "Acompanhe campanhas ativas, pausadas e encerradas em um único lugar."
        : "Acompanhe as campanhas ativas e encontre rapidamente onde sua ajuda pode gerar mais impacto.";

    private string EmptyStateMessage => Session.IsAuthenticated
        ? "Nenhuma campanha foi encontrada no momento."
        : "Nenhuma campanha ativa foi encontrada no momento.";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        await Session.EnsureInitializedAsync();
        await LoadCampaignsAsync();
        _hasCompletedInitialLoad = true;
    }

    private async void HandleSessionChanged()
    {
        if (!_hasCompletedInitialLoad || _lastAuthenticatedState == Session.IsAuthenticated)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await LoadCampaignsAsync();
        _hasCompletedInitialLoad = true;
            StateHasChanged();
        });
    }

    private async Task LoadCampaignsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var endpoint = Session.IsAuthenticated
                ? "api/Campaign?page=1&pageSize=12"
                : "api/Campaign/active?page=1&pageSize=12";

            var response = await Http.GetAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PagedResult<CampaignSummaryModel>>();
                _campaigns.Clear();

                if (result?.Items is not null)
                {
                    _campaigns.AddRange(result.Items);
                }

                _lastAuthenticatedState = Session.IsAuthenticated;
                return;
            }

            _errorMessage = "Não foi possível carregar as campanhas agora.";
        }
        catch
        {
            _errorMessage = "Não foi possível se conectar ao servidor no momento.";
        }
        finally
        {
            _lastAuthenticatedState = Session.IsAuthenticated;
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        Session.Changed -= HandleSessionChanged;
    }
}