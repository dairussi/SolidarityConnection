@code {
    private readonly List<CampaignSummaryModel> _campaigns = [];
    private readonly HashSet<Guid> _campaignsUpdatingStatus = [];
    private readonly HashSet<Guid> _campaignsDeleting = [];

    private string? _errorMessage;
    private Guid? _pendingDeleteCampaignId;
    private bool _isLoading = true;
    private bool? _lastAuthenticatedState;
    private bool _hasCompletedInitialLoad;

    private CampaignSummaryModel? PendingDeleteCampaign
        => _pendingDeleteCampaignId is Guid campaignId
            ? _campaigns.FirstOrDefault(campaign => campaign.Id == campaignId)
            : null;

    private bool IsPendingDeleteBusy
        => PendingDeleteCampaign is not null && _campaignsDeleting.Contains(PendingDeleteCampaign.Id);

    private string HomeDescription => Session.IsAdmin
        ? "Acompanhe as campanhas e use os controles administrativos para atualizar status ou remover campanhas sem arrecadação."
        : Session.IsAuthenticated
            ? "Acompanhe campanhas ativas, pausadas e encerradas em um único lugar."
            : "Acompanhe as campanhas ativas e encontre rapidamente onde sua ajuda pode gerar mais impacto.";

    private string EmptyStateMessage => Session.IsAuthenticated
        ? "Nenhuma campanha foi encontrada no momento."
        : "Nenhuma campanha ativa foi encontrada no momento.";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        await Session.EnsureInitializedAsync();
        await LoadCampaignsAsync();
        _hasCompletedInitialLoad = true;
    }

    private async void HandleSessionChanged()
    {
        if (!_hasCompletedInitialLoad || _lastAuthenticatedState == Session.IsAuthenticated)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await LoadCampaignsAsync();
            _hasCompletedInitialLoad = true;
            StateHasChanged();
        });
    }

    private async Task LoadCampaignsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var endpoint = Session.IsAuthenticated
                ? "api/Campaign?page=1&pageSize=12"
                : "api/Campaign/active?page=1&pageSize=12";

            var response = await Http.GetAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PagedResult<CampaignSummaryModel>>();
                _campaigns.Clear();

                if (result?.Items is not null)
                {
                    _campaigns.AddRange(result.Items);
                }

                SyncAdminState();
                _lastAuthenticatedState = Session.IsAuthenticated;
                return;
            }

            _errorMessage = "Não foi possível carregar as campanhas agora.";
        }
        catch
        {
            _errorMessage = "Não foi possível se conectar ao servidor no momento.";
        }
        finally
        {
            _lastAuthenticatedState = Session.IsAuthenticated;
            _isLoading = false;
        }
    }

    private void SyncAdminState()
    {
        var activeCampaignIds = _campaigns.Select(campaign => campaign.Id).ToHashSet();

        CleanupState(_campaignsUpdatingStatus, activeCampaignIds);
        CleanupState(_campaignsDeleting, activeCampaignIds);

        if (_pendingDeleteCampaignId is Guid campaignId && !activeCampaignIds.Contains(campaignId))
        {
            _pendingDeleteCampaignId = null;
        }
    }

    private static void CleanupState(HashSet<Guid> state, HashSet<Guid> activeCampaignIds)
    {
        foreach (var campaignId in state.Where(campaignId => !activeCampaignIds.Contains(campaignId)).ToList())
        {
            state.Remove(campaignId);
        }
    }

    private bool IsCurrentStatus(CampaignSummaryModel campaign, int status)
        => GetCurrentStatusValue(campaign.Status) == status;

    private string GetStatusActionLabel(CampaignSummaryModel campaign)
        => $"Status: {GetStatusName(GetCurrentStatusValue(campaign.Status))}";

    private void OpenDeleteModal(Guid campaignId)
    {
        _pendingDeleteCampaignId = campaignId;
    }

    private void CloseDeleteModal()
    {
        if (!IsPendingDeleteBusy)
        {
            _pendingDeleteCampaignId = null;
        }
    }

    private async Task ChangeCampaignStatusAsync(CampaignSummaryModel campaign, int status)
    {
        if (!Session.IsAdmin || IsCurrentStatus(campaign, status) || !_campaignsUpdatingStatus.Add(campaign.Id))
        {
            return;
        }

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Patch, $"api/Campaign/{campaign.Id}/status")
            {
                Content = JsonContent.Create(new UpdateCampaignStatusRequest
                {
                    Status = status
                })
            };

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Status da campanha atualizado para {GetStatusName(status).ToLower()}.", Severity.Success);
                await LoadCampaignsAsync();
                StateHasChanged();
                return;
            }

            var message = await ReadErrorMessageAsync(response, "Não foi possível atualizar o status da campanha.");
            Snackbar.Add(message, Severity.Error);
        }
        catch
        {
            Snackbar.Add("Não foi possível se conectar ao servidor no momento.", Severity.Error);
        }
        finally
        {
            _campaignsUpdatingStatus.Remove(campaign.Id);
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (PendingDeleteCampaign is null)
        {
            return;
        }

        await DeleteCampaignAsync(PendingDeleteCampaign);
    }

    private async Task DeleteCampaignAsync(CampaignSummaryModel campaign)
    {
        if (!Session.IsAdmin || !_campaignsDeleting.Add(campaign.Id))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/Campaign/{campaign.Id}");

            if (response.IsSuccessStatusCode)
            {
                _pendingDeleteCampaignId = null;
                Snackbar.Add("Campanha excluída com sucesso.", Severity.Success);
                await LoadCampaignsAsync();
                StateHasChanged();
                return;
            }

            var message = await ReadErrorMessageAsync(response, "Não foi possível excluir a campanha.");
            Snackbar.Add(message, Severity.Error);
        }
        catch
        {
            Snackbar.Add("Não foi possível se conectar ao servidor no momento.", Severity.Error);
        }
        finally
        {
            _campaignsDeleting.Remove(campaign.Id);
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        try
        {
            var failure = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            return string.IsNullOrWhiteSpace(failure?.Message) ? fallbackMessage : failure.Message;
        }
        catch
        {
            return fallbackMessage;
        }
    }

    private static int GetCurrentStatusValue(string? status)
        => (status ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            "PAUSED" => 2,
            "CLOSED" => 3,
            _ => 1
        };

    private static string GetStatusName(int status)
        => status switch
        {
            2 => "Pausada",
            3 => "Encerrada",
            _ => "Ativa"
        };

    public void Dispose()
    {
        Session.Changed -= HandleSessionChanged;
    }

    private sealed class UpdateCampaignStatusRequest
    {
        public int Status { get; set; }
    }

    private sealed class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}