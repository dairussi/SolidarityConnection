@page "/"
@implements IDisposable
@inject HttpClient Http
@inject AppSessionService Session
@inject ISnackbar Snackbar

<PageTitle>Conexão Solidária | Campanhas</PageTitle>

<div class="home-shell">
    <div class="home-stage">
        <section class="home-panel">
            <div class="home-copy">
                <MudText Typo="Typo.h4" HtmlTag="h1" Class="home-heading">Campanhas em destaque</MudText>
                <MudText Typo="Typo.body1" Class="home-description">
                    @HomeDescription
                </MudText>
            </div>

            @if (_isLoading)
            {
                <div class="campaign-grid">
                    @for (var index = 0; index < 3; index++)
                    {
                        <div class="campaign-skeleton"></div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @_errorMessage
                </MudAlert>
            }
            else if (_campaigns.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @EmptyStateMessage
                </MudAlert>
            }
            else
            {
                <div class="campaign-grid">
                    @foreach (var campaign in _campaigns)
                    {
                        var isStatusBusy = _campaignsUpdatingStatus.Contains(campaign.Id);
                        var isDeleteBusy = _campaignsDeleting.Contains(campaign.Id);

                        <article class="campaign-shell">
                            <CampaignCard Campaign="campaign" />

                            @if (Session.IsAdmin)
                            {
                                <div class="campaign-admin-actions">
                                    <MudMenu Label="@GetStatusActionLabel(campaign)"
                                             Variant="Variant.Text"
                                             Color="Color.Default"
                                             Dense="true"
                                             EndIcon="@Icons.Material.Filled.ExpandMore"
                                             Class="campaign-admin-menu"
                                             Disabled="@(isStatusBusy || isDeleteBusy)">
                                        <MudMenuItem Disabled="@(isStatusBusy || isDeleteBusy || IsCurrentStatus(campaign, 1))"
                                                     OnClick="() => ChangeCampaignStatusAsync(campaign, 1)">
                                            Definir como ativa
                                        </MudMenuItem>
                                        <MudMenuItem Disabled="@(isStatusBusy || isDeleteBusy || IsCurrentStatus(campaign, 2))"
                                                     OnClick="() => ChangeCampaignStatusAsync(campaign, 2)">
                                            Definir como pausada
                                        </MudMenuItem>
                                        <MudMenuItem Disabled="@(isStatusBusy || isDeleteBusy || IsCurrentStatus(campaign, 3))"
                                                     OnClick="() => ChangeCampaignStatusAsync(campaign, 3)">
                                            Definir como encerrada
                                        </MudMenuItem>
                                    </MudMenu>

                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                                               Class="campaign-admin-button"
                                               OnClick="() => OpenDeleteModal(campaign.Id)"
                                               Disabled="@(isStatusBusy || isDeleteBusy)">
                                        Excluir
                                    </MudButton>

                                    @if (isStatusBusy || isDeleteBusy)
                                    {
                                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="campaign-admin-loader" />
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@if (PendingDeleteCampaign is not null)
{
    <div class="campaign-admin-modal-backdrop" @onclick="CloseDeleteModal"></div>

    <section class="campaign-admin-modal-shell" aria-modal="true" role="dialog" aria-label="Confirmar exclusão da campanha">
        <div class="campaign-admin-modal-card" @onclick:stopPropagation="true">
            <div class="campaign-admin-modal-header">
                <div>
                    <p class="campaign-admin-modal-kicker">Excluir campanha</p>
                    <h3 class="campaign-admin-modal-title">Confirmar exclusão da campanha?</h3>
                </div>

                <button type="button" class="campaign-admin-modal-close" @onclick="CloseDeleteModal" aria-label="Fechar modal">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>

            <p class="campaign-admin-modal-copy">
                Você está prestes a excluir <strong>@PendingDeleteCampaign.Title</strong>.
            </p>

            <p class="campaign-admin-modal-helper">
                A exclusão só será concluída se o valor arrecadado estiver em R$ 0,00.
            </p>

            <div class="campaign-admin-modal-actions">
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="CloseDeleteModal"
                           Disabled="@IsPendingDeleteBusy">
                    Cancelar
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="ConfirmDeleteAsync"
                           Disabled="@IsPendingDeleteBusy">
                    @if (IsPendingDeleteBusy)
                    {
                        <MudProgressCircular Class="me-2"
                                             Color="Color.Inherit"
                                             Size="Size.Small"
                                             Indeterminate="true" />
                        <span>Excluindo...</span>
                    }
                    else
                    {
                        <span>Confirmar</span>
                    }
                </MudButton>
            </div>
        </div>
    </section>
}

