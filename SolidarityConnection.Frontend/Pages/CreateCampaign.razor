@page "/campanhas/nova"
@inject AppSessionService Session
@inject NavigationManager Navigation

<PageTitle>Conexão Solidária | Nova campanha</PageTitle>

<div class="placeholder-shell">
    <MudPaper Class="placeholder-card" Elevation="0">
        <MudText Typo="Typo.overline" Class="placeholder-kicker">Área do gestor</MudText>
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="placeholder-title">Cadastro de campanha</MudText>
        <MudText Typo="Typo.body1" Class="placeholder-copy">
            Este acesso já ficou amarrado no menu do admin. Na próxima etapa, montamos o formulário de criação aqui.
        </MudText>
        <MudButton Href="/" Color="Color.Primary" Variant="Variant.Filled">
            Voltar para campanhas
        </MudButton>
    </MudPaper>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitializedAsync();

        if (!Session.IsAdmin)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }
}