@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="app-layout">
    @if (!IsAuthRoute)
    {
        <AppMenu />
    }

    <main class="app-main @(IsAuthRoute ? "app-main-login" : string.Empty)">
        <div class="app-page-host">
            @Body
        </div>
    </main>
</div>

<style>
    .app-layout {
        --app-menu-height: 3.9rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .app-main {
        flex: 1 1 auto;
        min-height: calc(100vh - var(--app-menu-height));
        display: flex;
        background: #fff;
    }

    .app-main-login {
        min-height: 100vh;
    }

    .app-page-host {
        flex: 1 1 auto;
        min-height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .app-page-host:focus {
        outline: none;
    }
</style>

@code {
    private bool IsAuthRoute
    {
        get
        {
            var route = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');

            return string.Equals(route, "login", StringComparison.OrdinalIgnoreCase)
                || string.Equals(route, "cadastro", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
