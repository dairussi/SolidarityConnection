{
  "title": "SolidarityConnection API",
  "uid": "solidarity-api",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Requisições HTTP por Segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total[1m])",
          "legendFormat": "req/s",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 2,
      "title": "Uso de Memória (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "process_working_set_bytes / 1024 / 1024",
          "legendFormat": "Memória MB",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU Segundos Total",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "CPU %",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 4,
      "title": "Threads Ativos",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "process_num_threads",
          "legendFormat": "Threads",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 5,
      "title": "Coletas de GC",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(dotnet_collection_count_total[1m])",
          "legendFormat": "GC Gen {{generation}}",
          "datasource": "Prometheus"
        }
      ]
    }
  ]
}